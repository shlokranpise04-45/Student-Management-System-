pipeline {
    agent any

    stages {

        stage('Verify Application Files') {
            steps {
                echo 'Verifying project files...'

                bat '''
                if exist index.html (
                    echo index.html Found
                ) else (
                    exit /b 1
                )

                if exist style.css (
                    echo style.css Found
                ) else (
                    exit /b 1
                )

                if exist script.js (
                    echo script.js Found
                ) else (
                    exit /b 1
                )
                '''
            }
        }

        stage('Create Build Artifact') {
            steps {
                echo 'Creating ZIP file...'

                bat '''
                if exist StudentManagementSystem.zip del StudentManagementSystem.zip
                powershell -Command "Compress-Archive -Path index.html,style.css,script.js,Jenkinsfile -DestinationPath StudentManagementSystem.zip -Force"
                '''
            }
        }

        stage('Archive Build') {
            steps {
                archiveArtifacts artifacts: 'StudentManagementSystem.zip', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Application Build Successful.'
        }

        failure {
            echo 'Application Build Failed.'
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}